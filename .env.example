# ==========================================
# CẤU HÌNH HỆ THỐNG CƠ BẢN
# ==========================================

# Khóa bí mật cho JWT Auth (Nên đổi chuỗi ngẫu nhiên dài trên Production)
SECRET_KEY=your_super_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cấu hình Upload File
UPLOAD_DIR=/app/data
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# DATABASE & MESSAGING (DOCKER)
# ==========================================

# Chuỗi kết nối PostgreSQL (Dùng mặc định cho Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# RabbitMQ (Celery Broker)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# ==========================================
# CẤU HÌNH AI & LLM
# ==========================================

# API Key của Google Gemini (Bắt buộc)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# HỆ THỐNG GIÁM SÁT (LANGFUSE)
# ==========================================
# Lấy Key miễn phí tại https://cloud.langfuse.com

LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
